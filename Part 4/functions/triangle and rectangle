# Problem: Triangle + Rectangle shape
# Learned: how to reuse a function (line) inside another function
# Learned: difference between changing value (i) vs fixed value (size)
# Mistake: used height instead of size for rectangle width initially



def line(length, character):
    if character == '':
        text = length * '*'
    else:
        text = length * character[0]
    return text

def shape(size,T_char, height, R_char ):
    for i in range(1, size+1):
        print(line(i, T_char ))

    for i in range(height):
        print(line(size, R_char))

shape(4, '*', 5, '#')
