Learned: 
        Store a string itself to compare with others.
        
Confusion:
          Should helper variable store the string itself or just its length?  
        
    

def shortest(collection : list):
    least = collection[0]
    for i in collection:
        if len(i) < len(least):
            least = i
    return least

my_list = ['hello', 'laptop', 'hi', 'refrigerator' ]
print(shortest(my_list))
